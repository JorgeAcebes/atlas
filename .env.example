NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Cloudflare R2 (Almacenamiento de Fotos - 10 GB Gratis)
CLOUDFLARE_R2_ACCOUNT_ID=tu-account-id-de-cloudflare
CLOUDFLARE_R2_ACCESS_KEY_ID=tu-access-key-id-de-r2
CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu-secret-access-key-de-r2
CLOUDFLARE_R2_BUCKET_NAME=atlas-photos
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Límite estricto de seguridad de almacenamiento (opcional, por defecto 9.5 GB = 10200547328 bytes)
MAX_STORAGE_BYTES=10200547328
